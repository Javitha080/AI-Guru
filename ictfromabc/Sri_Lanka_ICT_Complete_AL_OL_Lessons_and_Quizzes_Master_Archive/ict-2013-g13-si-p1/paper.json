[
  {
    "id": "al-2013-ict-si-p1-q01",
    "number": 1,
    "section": "mcq",
    "question_type": "choice",
    "marks": 1.0,
    "stem": "The Boolean expression $(x+y) \\cdot (x+z)$ simplifies to",
    "diagrams": [],
    "options": {
      "A": "$x$",
      "B": "$x \\cdot (y+z)$",
      "C": "$x \\cdot y \\cdot z$",
      "D": "$x + y \\cdot z$",
      "E": "$x + y + z$"
    },
    "reference_answer": "D",
    "explanation": "$(x+y)(x+z) = xx + xz + yx + yz = x + x(z+y) + yz = x(1 + z+y) + yz = x + yz$.",
    "metadata": {
      "subject": "ict",
      "grade": 13,
      "year": 2013,
      "medium": "sinhala",
      "topic": "General ICT",
      "difficulty": "medium"
    }
  },
  {
    "id": "al-2013-ict-si-p1-q02",
    "number": 2,
    "section": "mcq",
    "question_type": "choice",
    "marks": 1.0,
    "stem": "Which of the following Boolean expressions represents the output (Q) of the circuit shown below?\n\n![Logic Circuit](images/q02_circuit.png)",
    "diagrams": [
      {
        "id": "d_q02_circuit",
        "src": "images/q02_circuit.png",
        "alt": "Logic circuit for Q2",
        "caption": "Figure 1: Logic Circuit"
      }
    ],
    "options": {
      "A": "$A'B' + AB'$",
      "B": "$A'B' + AB$",
      "C": "$AB + A'B'$",
      "D": "$A'B + AB'$",
      "E": "$A'B + A'B'$"
    },
    "reference_answer": "A",
    "explanation": "Simplifying circuit expression gives $\\overline{A'B + B} = (A + B')B' = AB' + B' = B'(A+1) = B'$, matching $A'B' + AB' = B'(A'+A) = B'$.",
    "metadata": {
      "subject": "ict",
      "grade": 13,
      "year": 2013,
      "medium": "sinhala",
      "topic": "General ICT",
      "difficulty": "medium"
    }
  },
