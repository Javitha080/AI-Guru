    "number": 21,
    "section": "mcq",
    "question_type": "choice",
    "marks": 1.0,
    "stem": "$124_8 + 165_8 =$",
    "diagrams": [],
    "options": {
      "A": "$201_8$",
      "B": "$289_{10}$",
      "C": "$289_8$",
      "D": "$311_8$",
      "E": "$389_8$"
    },
    "reference_answer": "D",
    "explanation": "$4+5 = 11_8$ (carry 1); $2+6+1 = 11_8$ (carry 1); $1+1+1 = 3_8$. Result: $311_8$.",
    "metadata": {
