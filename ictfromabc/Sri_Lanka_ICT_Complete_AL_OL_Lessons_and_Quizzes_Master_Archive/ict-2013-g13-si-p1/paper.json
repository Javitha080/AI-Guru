    "question_type": "choice",
    "marks": 1.0,
    "stem": "The binary number equivalent to $25_{10}$ is",
    "diagrams": [],
    "options": {
      "A": "$0100101_2$",
      "B": "$0100111_2$",
      "C": "$0011001_2$",
      "D": "$0010110_2$",
      "E": "$0010111_2$"
    },
    "reference_answer": "C",
    "explanation": "$25 = 16 + 8 + 1 = 11001_2$, which in 7 bits is $0011001_2$.",
    "metadata": {
      "subject": "ict",
      "grade": 13,
      "year": 2013,
      "medium": "sinhala",
      "topic": "General ICT",
      "difficulty": "medium"
    }
  },
