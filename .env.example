# ============================================
# DeepTutor (podman compose) — host-side configuration
# ============================================
# Copy to .env and edit. `.env` is gitignored.
#
# All values are loopback bindings on the HOST side. The container-side
# ports come from data/user/settings/system.json (backend_port, frontend_port).
# Edit those + `podman compose restart deeptutor` to change the in-container
# ports. This file is for shifting the host-side mapping only.
#
# The API base URL the browser uses is NOT a compose env var. The
# entrypoint reads `DEEPTUTOR_API_BASE_URL` from
# data/user/settings/system.json on every start (preferring the
# in-network `next_public_api_base`, then the external override
# `next_public_api_base_external`, then `http://localhost:${BACKEND_PORT}`),
# and web/proxy.ts rewrites /api/* and /ws/* to it at request time.
# ============================================

# Host-side loopback bindings (override if 8001/3782/8090 are taken)
HOST_PORT_BACKEND=8001
HOST_PORT_FRONTEND=3782
HOST_PORT_POCKETBASE=8090

# Time zone passed into both backend and frontend.
TZ=UTC

# ============================================
# AI Guru — Parent Supervision (optional)
# ============================================
# Everything below is OPTIONAL and normally configured through the UI:
#   /parent          → PIN passcode, Telegram bot, tunnel, vault
#   /exam            → past-paper exam room
#   /study-room      → monitored study sessions (local CV)
#
# Tunnel binaries (pick one; outbound-only, no port forwarding):
#   cloudflared  — https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/
#   ngrok        — https://ngrok.com/download  (+ auth token via /parent wizard)
# If neither binary is on PATH the portal stays LAN/local-only and the tunnel
# status honestly reports `local_only`.
#
# Telegram notifications are configured per-parent inside the portal
# (BotFather token + chat id) and stored locally in chat_history.db.
# Monitoring frames never leave this machine; only text alerts are sent.

# ============================================
# API Keys (placeholders — NEVER commit real keys)
# ============================================
# The only key read from this file/environment:
GROQ_API_KEY=your_groq_api_key_here

# All other cloud provider keys (OpenAI, Anthropic, Gemini, embedding
# providers...) are entered in Settings → AI Models in the web UI and
# stored locally under data/user/settings/. They never belong in git.
# Copy this file to `.env` (gitignored) and fill in real values there.

